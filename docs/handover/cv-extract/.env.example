# Server-side only. Never committed, never sent to a browser.
#
# These are read by the Supabase Edge Functions, so they are set with
# `supabase secrets set`, not by copying this file anywhere. It exists to
# record what the functions need.
#
#   supabase secrets set DIDIT_API_KEY=...
#   supabase secrets set DIDIT_WEBHOOK_SECRET=...

DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Optional. Defaults to the "Free KYC" workflow if unset. Not a secret — it is
# per-session configuration, and it is passed in the create-session body.
DIDIT_WORKFLOW_ID=b298bbe5-267f-4af3-9107-11025cebb290

# Where Didit returns the candidate after the flow. A UI convenience only: the
# webhook, not this redirect, decides whether they are verified.
VERIFY_CALLBACK_URL=
