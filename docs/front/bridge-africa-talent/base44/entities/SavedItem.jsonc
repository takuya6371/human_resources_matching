{
  "name": "SavedItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who saved"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "job",
        "challenge",
        "post",
        "talent",
        "company"
      ]
    },
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "item_image": {
      "type": "string"
    },
    "item_meta": {
      "type": "string",
      "description": "Short subtitle e.g. company name or location"
    }
  },
  "required": [
    "user_id",
    "item_type",
    "item_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}