{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "post_title": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "post",
        "challenge"
      ],
      "default": "post",
      "description": "Whether the promoted item is a Post or a Challenge"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "talent",
        "company"
      ]
    },
    "goal": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "duration_days": {
      "type": "number"
    },
    "daily_budget": {
      "type": "number"
    },
    "total_budget": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "under_review",
        "active",
        "paused",
        "completed"
      ],
      "default": "under_review"
    },
    "reach": {
      "type": "number",
      "default": 0
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "profile_visits": {
      "type": "number",
      "default": 0
    },
    "new_followers": {
      "type": "number",
      "default": 0
    },
    "engagement": {
      "type": "number",
      "default": 0
    },
    "link_clicks": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "post_id",
    "owner_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}