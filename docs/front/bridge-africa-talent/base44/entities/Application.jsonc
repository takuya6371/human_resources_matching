{
  "name": "Application",
  "type": "object",
  "properties": {
    "talent_id": {
      "type": "string",
      "description": "Linked TalentProfile id"
    },
    "talent_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "cover_letter": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "shortlisted",
        "interview",
        "offer",
        "hired",
        "rejected"
      ],
      "default": "applied"
    }
  },
  "required": [
    "talent_id",
    "job_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}