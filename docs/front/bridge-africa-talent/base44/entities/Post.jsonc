{
  "name": "Post",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Linked CompanyProfile id"
    },
    "company_name": {
      "type": "string"
    },
    "company_logo": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "opportunity",
        "scholarship",
        "program",
        "social_problem"
      ],
      "default": "opportunity",
      "description": "Kind of post: job/opportunity, scholarship, program, or a social problem seeking ideas"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string",
      "description": "Optional video URL (uploaded file or embed link)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "shares": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "company_id",
    "title",
    "body"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}