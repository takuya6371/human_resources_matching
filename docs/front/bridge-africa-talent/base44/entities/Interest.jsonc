{
  "name": "Interest",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string",
      "description": "User id expressing interest"
    },
    "from_name": {
      "type": "string"
    },
    "from_type": {
      "type": "string",
      "enum": [
        "talent",
        "company"
      ],
      "description": "Account type of the sender"
    },
    "to_user_id": {
      "type": "string",
      "description": "User id of the target"
    },
    "to_type": {
      "type": "string",
      "enum": [
        "talent",
        "company"
      ]
    },
    "to_profile_id": {
      "type": "string",
      "description": "Profile id of the target (TalentProfile or CompanyProfile)"
    },
    "to_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "description": "Optional: interest tied to a specific job"
    }
  },
  "required": [
    "from_user_id",
    "from_type",
    "to_user_id",
    "to_type"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}