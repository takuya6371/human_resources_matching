{
  "name": "AssessmentResult",
  "type": "object",
  "properties": {
    "talent_id": {
      "type": "string",
      "description": "Linked TalentProfile id"
    },
    "talent_name": {
      "type": "string"
    },
    "assessment_id": {
      "type": "string"
    },
    "assessment_title": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "description": "Percentage scored"
    },
    "total": {
      "type": "number",
      "description": "Total questions"
    },
    "passed": {
      "type": "boolean",
      "default": false
    },
    "credits_earned": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "talent_id",
    "assessment_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}