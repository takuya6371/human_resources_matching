{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Recipient user id"
    },
    "actor_id": {
      "type": "string",
      "description": "User who triggered the notification"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "talent",
        "company",
        "system"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "follow",
        "like",
        "comment",
        "reply",
        "mention",
        "message",
        "application",
        "opportunity",
        "match",
        "challenge",
        "prize",
        "subscription",
        "platform",
        "idea"
      ],
      "description": "Kind of notification"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "description": "e.g. post, challenge, job, talent, company"
    },
    "target_id": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}