# Copy this file to .env.local and fill in the values.
#
# For local development against the Supabase CLI (`supabase start`), the
# values below are the fixed local demo credentials that the CLI always
# generates — not secrets, safe to keep as-is.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# To point at the production Supabase project instead, get these from
# Project Settings -> API in the Supabase dashboard.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-public-key>
